# Скопируйте в «.env» в каталоге данных приложения или в корень репозитория.
# См. README: порядок загрузки и переменные для HTTP LLM.

# --- OpenAI-совместимый HTTP LLM (провайдер http_openai в GUI) ---
LANG_LEARN_HTTP_LLM_BASE_URL=https://api.openai.com/v1
LANG_LEARN_HTTP_LLM_API_KEY=
LANG_LEARN_HTTP_LLM_MODEL=gpt-4o-mini
# LANG_LEARN_HTTP_LLM_TIMEOUT_SEC=60
